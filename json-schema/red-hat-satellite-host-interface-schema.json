{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HostInterface",
  "type": "object",
  "description": "A network interface associated with a host.",
  "properties": {
    "id": {
      "type": "integer"
    },
    "mac": {
      "type": "['string', 'null']"
    },
    "ip": {
      "type": "['string', 'null']"
    },
    "ip6": {
      "type": "['string', 'null']"
    },
    "type": {
      "type": "string"
    },
    "name": {
      "type": "['string', 'null']"
    },
    "subnet_id": {
      "type": "['integer', 'null']"
    },
    "subnet6_id": {
      "type": "['integer', 'null']"
    },
    "domain_id": {
      "type": "['integer', 'null']"
    },
    "identifier": {
      "type": "['string', 'null']",
      "description": "Device identifier (e.g., eth0, ens192)."
    },
    "managed": {
      "type": "boolean"
    },
    "primary": {
      "type": "boolean"
    },
    "provision": {
      "type": "boolean"
    },
    "virtual": {
      "type": "boolean"
    },
    "tag": {
      "type": "['string', 'null']",
      "description": "VLAN tag."
    },
    "mtu": {
      "type": "['integer', 'null']",
      "description": "Maximum transmission unit."
    },
    "attached_to": {
      "type": "['string', 'null']",
      "description": "Parent interface identifier."
    }
  }
}
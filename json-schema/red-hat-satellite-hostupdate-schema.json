{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/HostUpdate",
  "title": "HostUpdate",
  "type": "object",
  "description": "Parameters for updating an existing host.",
  "properties": {
    "name": {
      "type": "string",
      "example": "Example Title"
    },
    "ip": {
      "type": "string",
      "format": "ipv4",
      "example": "example_value"
    },
    "mac": {
      "type": "string",
      "example": "example_value"
    },
    "architecture_id": {
      "type": "integer",
      "example": "500123"
    },
    "domain_id": {
      "type": "integer",
      "example": "500123"
    },
    "subnet_id": {
      "type": "integer",
      "example": "500123"
    },
    "operatingsystem_id": {
      "type": "integer",
      "example": "500123"
    },
    "hostgroup_id": {
      "type": "integer",
      "example": "500123"
    },
    "location_id": {
      "type": "integer",
      "example": "500123"
    },
    "organization_id": {
      "type": "integer",
      "example": "500123"
    },
    "owner_id": {
      "type": "integer",
      "example": "500123"
    },
    "owner_type": {
      "type": "string",
      "enum": [
        "User",
        "Usergroup"
      ],
      "example": "User"
    },
    "build": {
      "type": "boolean",
      "example": true
    },
    "managed": {
      "type": "boolean",
      "example": true
    },
    "comment": {
      "type": "string",
      "example": "example_value"
    },
    "content_facet_attributes": {
      "type": "object",
      "properties": {
        "content_view_id": {
          "type": "integer"
        },
        "lifecycle_environment_id": {
          "type": "integer"
        },
        "content_source_id": {
          "type": "integer"
        }
      },
      "example": "example_value"
    },
    "interfaces_attributes": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/HostInterfaceCreate"
      },
      "example": []
    }
  }
}